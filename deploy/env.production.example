# Copy to /opt/traffic-depot/.env on the server and fill in the values.
NODE_ENV=production
TRUST_PROXY=1
HOST=127.0.0.1
PORT=3000
DB_PATH=/var/lib/traffic-depot/traffic-depot.db

APP_PASSWORD=
SESSION_SECRET=

HUBSPOT_TOKEN=
HUBSPOT_PORTAL_ID=
GOOGLE_MAPS_API_KEY=

RECENT_DAYS=90
ALLOW_NON_GA=true
PURCHASE_PROVIDER=hubspot_deals
