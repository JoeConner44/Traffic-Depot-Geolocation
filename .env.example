# --- Required for the web app ---
# Shared password for the map page. Use a long random value.
APP_PASSWORD=change-me
# Random string used to sign the session cookie (e.g. `openssl rand -hex 32`).
SESSION_SECRET=change-me-too

# --- Required for `npm run sync` (not needed for the demo) ---
# HubSpot private app token (read-only scopes, see README).
HUBSPOT_TOKEN=
# HubSpot account/portal ID, used to build record links (Settings > Account Defaults).
HUBSPOT_PORTAL_ID=
# Google Maps Geocoding API key (server-side only).
GOOGLE_MAPS_API_KEY=

# --- Optional: Shopify purchase provider (PURCHASE_PROVIDER=shopify) ---
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=

# --- Behaviour / config (defaults shown) ---
# Days that count as "recent" for green / yellow.
RECENT_DAYS=90
# Also treat hs_email_last_send_date as a contact touch.
INCLUDE_EMAIL_SEND_DATE=false
# hubspot_deals | shopify
PURCHASE_PROVIDER=hubspot_deals
# Map contacts outside Georgia too (default: skip non-GA, blank state is treated as GA).
ALLOW_NON_GA=false

# --- Server ---
PORT=3000
# Interface to listen on. 127.0.0.1 when behind Caddy/nginx (the deploy guide sets this).
HOST=0.0.0.0
DB_PATH=./data/traffic-depot.db
# Set to 1 when behind a reverse proxy / PaaS (needed for correct client IPs + secure cookies).
TRUST_PROXY=0
NODE_ENV=development
